{
  "name": "@diligentcorp/atlas-mui-vite-prototype",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A Vite project for prototyping Atlas with MUI",
  "scripts": {
    "dev": "concurrently -n api,vite -c cyan,green \"node --env-file=.env --import tsx/esm scripts/api-server.ts\" \"vite\"",
    "dev:api": "node --env-file=.env --import tsx/esm scripts/api-server.ts",
    "dev:vite": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "vercel:dev": "vercel dev",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:v2": "tsx scripts/migrate-v2.ts",
    "seed": "tsx scripts/seed-data.ts",
    "seed:risks": "tsx scripts/seed-cyber-risks.ts",
    "seed:controls": "tsx scripts/seed-controls.ts",
    "seed:relations": "node --env-file=.env --import tsx/esm scripts/seed-relationships.ts",
    "seed:all": "npm run seed && npm run seed:risks && npm run seed:controls && npm run seed:relations"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@ckeditor/ckeditor5-react": "^11.1.0",
    "@diligentcorp/atlas-react-bundle": "https://atlas.diligent.com/react-bundle.tgz",
    "@emotion/cache": "^11",
    "@emotion/react": "^11",
    "@emotion/styled": "^11",
    "@hello-pangea/dnd": "^18",
    "@lit/react": "^1",
    "@mui/material": "^7",
    "@mui/system": "^7",
    "@mui/utils": "^7",
    "@mui/x-data-grid": "^8",
    "@mui/x-data-grid-pro": "^8",
    "@mui/x-date-pickers": "^8",
    "@mui/x-date-pickers-pro": "^8",
    "@mui/x-license": "^8",
    "@mui/x-tree-view": "^8",
    "better-sqlite3": "^11.10.0",
    "chart.js": "^4.5.1",
    "ckeditor5": "^48.0.0",
    "date-fns": "^4.1.0",
    "lit": "^3",
    "react": "^19",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19",
    "react-router": "^7",
    "tslib": "^2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/node": "^5.0.0",
    "@vitejs/plugin-react": "^4",
    "concurrently": "^9.2.1",
    "next": "^15",
    "tsx": "^4.19.2",
    "typescript": "^5",
    "vite": "^7"
  }
}
